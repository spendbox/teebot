# Copy these names into Vercel > Project > Settings > Environment Variables.

# Supabase > Project Settings > API
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SECRET_KEY=your-secret-or-service-role-key

# Pick your own long passwords (letters and numbers, 20+ characters)
DASHBOARD_PASSWORD=choose-a-strong-password
CRON_SECRET=another-long-random-string

# Bybit > API Management (only needed for real-money mode)
BYBIT_API_KEY=
BYBIT_API_SECRET=

# Telegram @BotFather (optional)
TELEGRAM_BOT_TOKEN=

# console.anthropic.com > API Keys (optional AI reviewer)
ANTHROPIC_API_KEY=
